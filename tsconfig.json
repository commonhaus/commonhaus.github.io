{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "types": ["svelte"]
  },
  "include": ["member/**/*.ts", "member/**/*.svelte"],
  "exclude": ["node_modules", "public", "member/**/*_test.ts"]
}
